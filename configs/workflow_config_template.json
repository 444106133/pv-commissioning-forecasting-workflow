{
  "workflow": "Three-Stage Cross-Site PV Commissioning Forecasting Workflow",
  "target": {
    "normalization": "per_unit_dc_capacity",
    "daylight_elevation_min_deg": 10.0,
    "sensitivity_elevation_min_deg": 0.0,
    "min_valid_coverage_fraction": 0.80
  },
  "temporal_splits": {
    "buffer_gap_days": 8,
    "segments": ["fit", "tune", "calibration", "test"]
  },
  "stage1_metadata_qualification": {
    "drop_raw_log_capacities": true,
    "poa_ghi_ratio_clip": [0.0, 3.0],
    "poa_ghi_min_denom_wm2": 10.0,
    "faiman_u0": 25.0,
    "faiman_u1": 6.84,
    "silicon_temp_coeff_per_c": -0.004,
    "stc_temp_c": 25.0,
    "stc_irradiance_wm2": 1000.0,
    "pre_issue_fixed_tilt_range_gate": "abstain_to_G0"
  },
  "stage2_equivalence_testing": {
    "cross_validation": "leave_one_group_out",
    "equal_site_group_weight": true,
    "random_seeds": [17, 29, 43],
    "optuna_trials_per_family": 50,
    "tost_sesoi_pp": 0.20,
    "alpha": 0.05,
    "moving_block_bootstrap_hours": 168,
    "bootstrap_replicates_primary": 10000,
    "bootstrap_replicates_curves": 2000,
    "fdr_q": 0.05
  },
  "stage3_horizon_and_telemetry": {
    "horizons_hours": [1, 3, 6, 12, 24, 48],
    "gfs_publication_delay_hours": 6,
    "daylight_fallback_cs_min_wm2": 50.0,
    "commissioning_days": [0, 1, 3, 7, 14, 30, 60, 90],
    "shrinkage_half_saturation_days": 7.0,
    "residual_ridge_alpha_per_sample": 0.5
  }
}
